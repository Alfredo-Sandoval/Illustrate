/* Default dark theme, from Radium's generic widget rules. Colors are
   at-sign names from colors.json; theme: urls resolve to this theme's icons. */

QMainWindow,
QDialog {
  background: @surface-window;
  color: @text-primary;
  font-size: 13px;
}

QWidget {
  color: @text-primary;
  font-size: 13px;
}

QToolTip {
  background: @surface-control;
  color: @text-primary;
  border: 1px solid @border-panel;
  padding: 4px 7px;
}

QMenu,
QStatusBar,
QToolBar {
  background: @surface-panel;
  color: @text-primary;
}

QMenuBar {
  background: @surface-window;
  color: @text-primary;
}

QMenuBar::item {
  background: transparent;
  padding: 5px 10px;
  border-radius: 5px;
}

QMenuBar::item:selected,
QMenuBar::item:pressed {
  background: @border-panel;
  color: @text-bright;
}

QMenu {
  border: 1px solid @border-panel;
  padding: 4px;
}

QMenu::item {
  padding: 5px 22px 5px 12px;
  border-radius: 5px;
}

QMenu::item:selected {
  background: @neutral-light;
  color: @text-bright;
}

QMenu::separator {
  height: 1px;
  background: @border-panel;
  margin: 4px 8px;
}

QToolBar {
  border: 0;
  spacing: 6px;
  padding: 5px 10px;
}

QToolBar QLabel {
  background: transparent;
  color: @text-toolbar;
  padding: 0 0 0 2px;
}

QToolBar QLineEdit {
  background: @surface-panel;
  border: 1px solid @border-input;
  border-radius: 5px;
  padding: 3px 9px;
  min-height: 24px;
}

QToolBar::separator {
  background: transparent;
  width: 4px;
  margin: 0 1px;
}

QStatusBar {
  border-top: 1px solid @surface-hover;
  font-size: 12px;
}

QStatusBar QLabel {
  background: transparent;
  color: @text-secondary;
  padding: 0 4px;
}

QPushButton,
QToolButton {
  background: @surface-control;
  border: 1px solid @border-default;
  border-radius: 6px;
  padding: 6px 12px;
  min-height: 23px;
}

QPushButton:hover,
QToolButton:hover {
  background: @surface-hover;
  border-color: @border-strong;
}

QPushButton:pressed,
QToolButton:pressed {
  background: @accent-surface-active;
  border-color: @accent-border-pressed;
  color: @text-bright;
}

QPushButton:checked,
QToolButton:checked {
  background: @accent-surface-active;
  border-color: @accent-border-pressed;
  color: @text-selected;
}

QToolButton::menu-indicator,
QToolButton::menu-arrow {
  image: url(theme:chevron-down.svg);
  width: 8px;
  height: 6px;
}

QToolButton::menu-indicator {
  subcontrol-origin: padding;
  subcontrol-position: right center;
  right: 6px;
}

QToolButton::menu-button {
  background: transparent;
  border: 0;
  border-top-right-radius: 6px;
  border-bottom-right-radius: 6px;
  width: 16px;
}

QToolButton::menu-button:hover {
  background: @border-default;
}

QToolButton[popupMode="1"],
QToolButton[popupMode="2"] {
  padding-right: 18px;
}

QPushButton:disabled,
QToolButton:disabled,
QComboBox:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled {
  color: @neutral-light;
  background: @surface-raised;
  border-color: @border-subtle;
}

QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
  background: @surface-panel;
  color: @text-input;
  border: 1px solid @border-panel;
  border-radius: 6px;
  selection-background-color: @selection-background;
  selection-color: @text-bright;
  padding: 4px 8px;
  min-height: 23px;
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
  border-color: @input-focus-border;
}

QComboBox::drop-down {
  border: 0;
  width: 18px;
}

QComboBox::down-arrow {
  image: url(theme:chevron-down.svg);
  width: 10px;
  height: 7px;
}

QSpinBox,
QDoubleSpinBox {
  padding-right: 22px;
}

QSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button {
  subcontrol-origin: border;
  width: 18px;
  border: 0;
  background: transparent;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button {
  subcontrol-position: top right;
  border-top-right-radius: 6px;
  margin: 1px 1px 0 0;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button {
  subcontrol-position: bottom right;
  border-bottom-right-radius: 6px;
  margin: 0 1px 1px 0;
}

QSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover,
QDoubleSpinBox::down-button:hover {
  background: @surface-hover;
}

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow {
  image: url(theme:chevron-up.svg);
  width: 10px;
  height: 7px;
}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow {
  image: url(theme:chevron-down.svg);
  width: 10px;
  height: 7px;
}

QComboBox QAbstractItemView {
  background: @surface-control;
  border: 1px solid @border-input;
  selection-background-color: @selection-background;
  selection-color: @text-bright;
  outline: 0;
}

QTreeView,
QListView,
QTableView {
  background: @surface-panel;
  color: @text-primary;
  border: 1px solid @surface-hover;
  border-radius: 6px;
  selection-background-color: @selection-background;
  selection-color: @text-bright;
  alternate-background-color: @surface-control;
  outline: 0;
}

QTreeView::item,
QListView::item,
QTableView::item {
  padding: 4px 6px;
}

QTreeView::item:selected,
QListView::item:selected,
QTableView::item:selected {
  background: @selection-background;
  color: @text-bright;
}

QTreeView::item:hover,
QListView::item:hover,
QTableView::item:hover {
  background: @surface-hover;
}

QHeaderView::section {
  background: @surface-control;
  color: @text-secondary;
  border: 0;
  padding: 5px 7px;
  font-weight: 600;
}

QCheckBox::indicator {
  width: 15px;
  height: 15px;
  border: 1px solid @border-strong;
  border-radius: 4px;
  background: @surface-panel;
}

QCheckBox::indicator:checked {
  background: @selection-background;
  border-color: @accent-border-default;
  image: url(theme:check.svg);
}

QFrame,
QScrollArea,
QGraphicsView {
  border: 0;
}

QGroupBox QLabel {
  background: transparent;
  color: @text-muted;
}

QGroupBox {
  background: transparent;
  border: 0;
  border-radius: 0;
  margin-top: 14px;
  padding: 12px 0 0 0;
  font-weight: 700;
}

QGroupBox::title {
  subcontrol-origin: margin;
  subcontrol-position: top left;
  background: transparent;
  color: @text-context;
  font-size: 12px;
  padding: 0 6px 0 0;
  left: 0;
}

QDockWidget {
  background: @surface-panel;
  border: 1px solid @surface-hover;
  border-radius: 8px;
}

QDockWidget::title {
  background: @surface-control;
  border-bottom: 1px solid @surface-hover;
  border-top-left-radius: 8px;
  border-top-right-radius: 8px;
  padding: 10px 12px;
  text-align: left;
  font-size: 12px;
  font-weight: 600;
  color: @text-primary;
}

QMainWindow::separator {
  background: @surface-window;
  width: 6px;
  height: 6px;
}

QTabWidget::pane {
  border: 0;
  background: transparent;
}

QTabBar::tab {
  background: transparent;
  color: @text-muted;
  border: 0;
  border-radius: 5px;
  padding: 7px 12px;
  margin-right: 2px;
}

QTabBar::tab:selected {
  background: @border-panel;
  color: @text-primary;
}

QTabBar::tab:hover {
  background: @border-subtle;
  color: @text-control;
}

QTabBar QToolButton {
  background: @surface-panel;
  border: 0;
  border-radius: 0;
  min-height: 0;
  min-width: 0;
  padding: 0;
  width: 18px;
}

QTabBar QToolButton:hover {
  background: @surface-hover;
}

QTabBar QToolButton::left-arrow {
  image: url(theme:tab-scroll-left.svg);
  width: 6px;
  height: 9px;
}

QTabBar QToolButton::right-arrow {
  image: url(theme:tab-scroll-right.svg);
  width: 6px;
  height: 9px;
}

QSplitter::handle {
  background: @surface-window;
}

QSplitter::handle:hover {
  background: @border-panel;
}

QSlider::groove:horizontal {
  height: 4px;
  background: @border-strong;
  border-radius: 2px;
}

QSlider::sub-page:horizontal {
  background: @neutral-light;
  border-radius: 2px;
}

QSlider::handle:horizontal {
  width: 14px;
  height: 14px;
  margin: -5px 0;
  border-radius: 7px;
  background: @text-control;
}

QScrollBar:vertical,
QScrollBar:horizontal {
  background: @surface-control;
  border: 0;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
  background: @border-input;
  border-radius: 4px;
  min-height: 20px;
  min-width: 20px;
}

QScrollBar::handle:hover {
  background: @border-emphasis;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
  height: 0;
  border: 0;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
  width: 0;
  border: 0;
}

QPushButton[flat="true"] {
  background: transparent;
  border-color: transparent;
  color: @text-secondary;
}

QPushButton[flat="true"]:hover {
  background: @surface-hover;
  color: @text-primary;
}

QPushButton[flat="true"]:focus {
  border: 1px solid @toolbar-focus-border;
}

QPushButton[flat="true"]:disabled {
  color: @text-disabled;
}

/* Primary action, from Radium's primaryAction and AI primary buttons. */

QPushButton[buttonRole="primary"] {
  background: @selection-background;
  border-color: @accent-border-default;
  color: @text-selected;
}

QPushButton[buttonRole="primary"]:hover {
  background: @primary-hover-background;
  border-color: @primary-hover-border;
}

QPushButton[buttonRole="primary"]:disabled {
  color: @neutral-light;
  background: @surface-raised;
  border-color: @border-subtle;
}

/* Text areas from Radium's input rule; radio buttons and progress bars follow
   Radium's check box and slider. */

QTextEdit,
QPlainTextEdit {
  background: @surface-panel;
  color: @text-input;
  border: 1px solid @border-panel;
  border-radius: 6px;
  selection-background-color: @selection-background;
  selection-color: @text-bright;
  padding: 4px 8px;
  min-height: 23px;
}

QTextEdit:focus,
QPlainTextEdit:focus {
  border-color: @input-focus-border;
}

QTextEdit:disabled,
QPlainTextEdit:disabled {
  color: @neutral-light;
  background: @surface-raised;
  border-color: @border-subtle;
}

QRadioButton::indicator {
  width: 15px;
  height: 15px;
  border: 1px solid @border-strong;
  border-radius: 8px;
  background: @surface-panel;
}

QRadioButton::indicator:checked {
  background: @selection-background;
  border-color: @accent-border-default;
}

QProgressBar {
  background: @border-strong;
  border: none;
  border-radius: 4px;
  color: @text-primary;
  text-align: center;
  min-height: 10px;
}

QProgressBar::chunk {
  background: @neutral-light;
  border-radius: 4px;
}

QStatusBar::item {
  border: none;
}

QTableCornerButton::section {
  background: @surface-control;
  border: 0;
}

/* Button roles matching the light theme, vertical sliders matching the
   horizontal ones, and divider lines, in Radium's colors. */

QPushButton[buttonRole="navigation"] {
  background: transparent;
  border: 1px solid transparent;
  text-align: left;
  padding: 0 10px;
  border-radius: 6px;
  min-height: 34px;
  max-height: 34px;
}

QPushButton[buttonRole="navigation"]:hover {
  background: @surface-hover;
}

QPushButton[buttonRole="navigation"]:checked {
  background: @accent-surface-active;
  border-color: transparent;
  color: @text-selected;
}

QPushButton[buttonRole="navigation"]:focus {
  border-color: @input-focus-border;
}

QPushButton[buttonRole="icon"] {
  background: transparent;
  border: 1px solid transparent;
  padding: 0;
  min-height: 0;
  border-radius: 6px;
}

QPushButton[buttonRole="icon"]:hover {
  background: @surface-hover;
}

QPushButton[buttonRole="icon"]:focus {
  border-color: @input-focus-border;
}

QPushButton[buttonRole="icon"]:disabled {
  background: transparent;
}

QPushButton[buttonRole="secondary"] {
  border-color: @border-strong;
}

QSlider::groove:vertical {
  width: 4px;
  background: @border-strong;
  border-radius: 2px;
}

QSlider::add-page:vertical {
  background: @neutral-light;
  border-radius: 2px;
}

QSlider::handle:vertical {
  width: 14px;
  height: 14px;
  margin: 0 -5px;
  border-radius: 7px;
  background: @text-control;
}

/* Radium removes QFrame borders, so draw divider lines as a 1 px border. */
QFrame[frameShape="4"] {
  border: none;
  border-top: 1px solid @border-default;
  max-height: 1px;
}

QFrame[frameShape="5"] {
  border: none;
  border-left: 1px solid @border-default;
  max-width: 1px;
}
